# =============================================================================
# MediConsent backend environment template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas) -----------------------------------------------
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mediconsent?retryWrites=true&w=majority
MONGODB_URI=
# Legacy alias, honoured when MONGODB_URI is empty (leave blank normally).
MONGO_URI=
# Database to select. Defaults to "mediconsent".
DATABASE_NAME=mediconsent
# Connection timeouts in milliseconds (fail fast instead of hanging).
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000

# --- Authentication (Phase 4) ------------------------------------------------
# REQUIRED for sign-in. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Name of the HttpOnly session cookie.
AUTH_COOKIE_NAME=mediconsent_token

# --- Encryption (Phase 8 - Secure Medical File Handling) -------------------
# AES-256-GCM master encryption key.
# Requirements:
#   - Exactly 32 bytes (64 hex characters, or 32 raw UTF-8 characters).
#   - Required in production. In development/testing, a fallback key is used if omitted.
# Generate a cryptographically secure 32-byte key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=
# Private storage directory (relative to backend or absolute). Defaults to "./private_uploads".
# Private uploads store encrypted ciphertext only (never plaintext) and are git-ignored.
# Note: Local filesystem storage is suitable for college demonstration; durable private
# object storage (e.g. AWS S3 with SSE-KMS) is required for production deployment.
PRIVATE_STORAGE_PATH=./private_uploads

# --- Frontend origin (CORS) -------------------------------------------------
# Legacy alias CLIENT_URL is also honoured.
FRONTEND_URL=http://localhost:5173

# --- Blockchain (local Hardhat chain) ---------------------------------------
# Legacy alias RPC_URL is also honoured.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Filled in automatically after Phase 9 deployment (`npm run deploy:localhost` in /blockchain)
# Accepts CONTRACT_ADDRESS or MEDICONSENT_CONTRACT_ADDRESS
CONTRACT_ADDRESS=
MEDICONSENT_CONTRACT_ADDRESS=

# --- Admin seed account (Phase 4) -------------------------------------------
# Used ONLY by `npm run seed:admin` (scripts/seedAdmin.js). There is no public
# admin registration. Set a strong password, run the script once, then remove
# ADMIN_PASSWORD from this file.
ADMIN_NAME=MediConsent Administrator
ADMIN_EMAIL=admin@mediconsent.local
ADMIN_PASSWORD=
ADMIN_MOBILE=+91 00000 00000
